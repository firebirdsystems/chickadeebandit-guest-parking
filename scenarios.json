{
  "scenarios": [
    {
      "name": "guest-night ledger rows are writable only by the privileged group",
      "members": { "member": "adult" },
      "steps": [
        {
          "action": "db",
          "as": "member",
          "sql": "UPDATE app_guest_parking__nights SET status = 'closed'",
          "expect": { "status": 403 }
        },
        {
          "action": "db",
          "as": "member",
          "sql": "DELETE FROM app_guest_parking__nights",
          "expect": { "status": 403 }
        }
      ]
    },
    {
      "name": "a child can see guest nights and claims but cannot claim a spot or change the ledger",
      "members": { "kid": "child", "parent": "adult" },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_guest_parking__nights (id, date, capacity, status, note, created_by, created_at, updated_at) VALUES ('n1', '2026-02-01', 2, 'open', '', ?, ?, ?)",
          "params": ["{{parent}}", "2026-01-01T00:00:00Z", "2026-01-01T00:00:00Z"]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_guest_parking__claims (id, night_id, member_id, guest_name, vehicle, claimed_at) VALUES ('cl1', 'n1', ?, 'Grandma', 'Blue sedan', ?)",
          "params": ["{{parent}}", "2026-01-01T00:00:00Z"]
        },
        {
          "action": "db",
          "as": "kid",
          "sql": "SELECT id, status FROM app_guest_parking__nights",
          "expect": { "status": 200, "rowCount": 1, "rowsContain": [{ "id": "n1" }] }
        },
        {
          "action": "db",
          "as": "kid",
          "sql": "SELECT id FROM app_guest_parking__claims",
          "expect": { "status": 200, "rowCount": 1, "rowsContain": [{ "id": "cl1" }] }
        },
        {
          "action": "db",
          "as": "kid",
          "sql": "INSERT INTO app_guest_parking__claims (id, night_id, member_id, guest_name, vehicle, claimed_at) VALUES ('cl2', 'n1', ?, 'Friend', '', ?)",
          "params": ["{{kid}}", "2026-01-01T00:00:00Z"],
          "expect": { "status": 403 }
        },
        {
          "action": "db",
          "as": "kid",
          "sql": "DELETE FROM app_guest_parking__claims WHERE id = 'cl1'",
          "expect": { "status": 403 }
        },
        {
          "action": "db",
          "as": "kid",
          "sql": "UPDATE app_guest_parking__nights SET capacity = 0 WHERE id = 'n1'",
          "expect": { "status": 403 }
        },
        {
          "action": "db",
          "as": "kid",
          "sql": "DELETE FROM app_guest_parking__nights WHERE id = 'n1'",
          "expect": { "status": 403 }
        },
        {
          "action": "db",
          "as": "parent",
          "sql": "SELECT id, capacity FROM app_guest_parking__nights",
          "expect": { "status": 200, "rowCount": 1, "rowsContain": [{ "id": "n1", "capacity": 2 }] }
        },
        {
          "action": "db",
          "as": "parent",
          "sql": "SELECT id FROM app_guest_parking__claims",
          "expect": { "status": 200, "rowCount": 1 }
        }
      ]
    },
    {
      "name": "a board-group adult opens and edits a guest night; a plain adult outside the group is refused both",
      "members": { "boardie": "adult", "member": "adult" },
      "steps": [
        { "action": "seedGroup", "group": "board", "name": "Board", "members": ["boardie"] },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_guest_parking__settings (key, value) VALUES ('board_group_id', ?)",
          "params": ["{{group:board}}"]
        },
        {
          "action": "db",
          "as": "boardie",
          "sql": "INSERT INTO app_guest_parking__nights (id, date, capacity, status, note, created_by, created_at, updated_at) VALUES ('n1', '2026-02-01', 2, 'open', '', ?, '2026-01-01T00:00:00Z', '2026-01-01T00:00:00Z')",
          "params": ["{{boardie}}"],
          "expect": { "status": 200 }
        },
        {
          "action": "db",
          "as": "member",
          "sql": "INSERT INTO app_guest_parking__nights (id, date, capacity, status, note, created_by, created_at, updated_at) VALUES ('n2', '2026-02-02', 2, 'open', '', ?, '2026-01-01T00:00:00Z', '2026-01-01T00:00:00Z')",
          "params": ["{{member}}"],
          "expect": { "status": 403 }
        },
        {
          "action": "db",
          "as": "member",
          "sql": "UPDATE app_guest_parking__nights SET capacity = 9 WHERE id = 'n1'",
          "expect": { "status": 403 }
        },
        {
          "action": "db",
          "as": "boardie",
          "sql": "UPDATE app_guest_parking__nights SET capacity = 3 WHERE id = 'n1'",
          "expect": { "status": 200 }
        },
        {
          "action": "db",
          "as": "member",
          "sql": "SELECT id, capacity FROM app_guest_parking__nights",
          "expect": { "status": 200, "rowCount": 1, "rowsContain": [{ "id": "n1", "capacity": 3 }] }
        },
        {
          "action": "db",
          "as": "member",
          "sql": "DELETE FROM app_guest_parking__nights WHERE id = 'n1'",
          "expect": { "status": 403 }
        },
        {
          "action": "db",
          "as": "boardie",
          "sql": "DELETE FROM app_guest_parking__nights WHERE id = 'n1'",
          "expect": { "status": 200 }
        },
        {
          "action": "db",
          "as": "member",
          "sql": "SELECT id FROM app_guest_parking__nights",
          "expect": { "status": 200, "rowCount": 0 }
        }
      ]
    },
    {
      "name": "a range of nights opens as one batch: every night lands, or (one date already open) none does",
      "members": { "boardie": "adult", "member": "adult" },
      "steps": [
        { "action": "seedGroup", "group": "board", "name": "Board", "members": ["boardie"] },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_guest_parking__settings (key, value) VALUES ('board_group_id', ?)",
          "params": ["{{group:board}}"]
        },
        {
          "action": "batch",
          "as": "boardie",
          "statements": [
            { "sql": "INSERT INTO app_guest_parking__nights (id, date, capacity, status, note, created_by, created_at, updated_at) VALUES (?, ?, ?, 'open', ?, ?, ?, ?), (?, ?, ?, 'open', ?, ?, ?, ?)", "params": ["r1", "2026-02-01", 2, "Season", "{{boardie}}", "2026-01-01T00:00:00Z", "2026-01-01T00:00:00Z", "r2", "2026-02-02", 2, "Season", "{{boardie}}", "2026-01-01T00:00:00Z", "2026-01-01T00:00:00Z"] },
            { "sql": "INSERT INTO app_guest_parking__nights (id, date, capacity, status, note, created_by, created_at, updated_at) VALUES (?, ?, ?, 'open', ?, ?, ?, ?), (?, ?, ?, 'open', ?, ?, ?, ?)", "params": ["r3", "2026-02-03", 2, "Season", "{{boardie}}", "2026-01-01T00:00:00Z", "2026-01-01T00:00:00Z", "r4", "2026-02-04", 2, "Season", "{{boardie}}", "2026-01-01T00:00:00Z", "2026-01-01T00:00:00Z"] }
          ],
          "expect": { "status": 200, "changed": [2, 2] }
        },
        {
          "action": "db",
          "as": "member",
          "sql": "SELECT id, date, capacity, status FROM app_guest_parking__nights ORDER BY date ASC",
          "expect": { "status": 200, "rowCount": 4, "rowsContain": [{ "id": "r1", "date": "2026-02-01", "capacity": 2, "status": "open" }, { "id": "r4", "date": "2026-02-04" }] }
        },
        {
          "action": "batch",
          "as": "boardie",
          "statements": [
            { "sql": "INSERT INTO app_guest_parking__nights (id, date, capacity, status, note, created_by, created_at, updated_at) VALUES (?, ?, ?, 'open', ?, ?, ?, ?), (?, ?, ?, 'open', ?, ?, ?, ?)", "params": ["r5", "2026-02-05", 2, "Season", "{{boardie}}", "2026-01-01T00:00:00Z", "2026-01-01T00:00:00Z", "r6", "2026-02-06", 2, "Season", "{{boardie}}", "2026-01-01T00:00:00Z", "2026-01-01T00:00:00Z"] },
            { "sql": "INSERT INTO app_guest_parking__nights (id, date, capacity, status, note, created_by, created_at, updated_at) VALUES (?, ?, ?, 'open', ?, ?, ?, ?), (?, ?, ?, 'open', ?, ?, ?, ?)", "params": ["r7", "2026-02-04", 2, "Season", "{{boardie}}", "2026-01-01T00:00:00Z", "2026-01-01T00:00:00Z", "r8", "2026-02-07", 2, "Season", "{{boardie}}", "2026-01-01T00:00:00Z", "2026-01-01T00:00:00Z"] }
          ],
          "expect": { "status": 400, "errorIncludes": "UNIQUE" }
        },
        {
          "action": "db",
          "as": "member",
          "sql": "SELECT id FROM app_guest_parking__nights",
          "expect": { "status": 200, "rowCount": 4 }
        },
        {
          "action": "batch",
          "as": "member",
          "statements": [
            { "sql": "INSERT INTO app_guest_parking__nights (id, date, capacity, status, note, created_by, created_at, updated_at) VALUES (?, ?, ?, 'open', ?, ?, ?, ?), (?, ?, ?, 'open', ?, ?, ?, ?)", "params": ["r9", "2026-02-08", 2, "Season", "{{member}}", "2026-01-01T00:00:00Z", "2026-01-01T00:00:00Z", "r10", "2026-02-09", 2, "Season", "{{member}}", "2026-01-01T00:00:00Z", "2026-01-01T00:00:00Z"] }
          ],
          "expect": { "status": 403 }
        }
      ]
    }
  ]
}
